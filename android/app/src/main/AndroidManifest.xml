<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permite que o aplicativo acesse a API pela rede -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="controle_frota"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!--
            Desativa o Impeller no Android.
            Estamos fazendo isso porque o seu Samsung
            apresentou problemas de renderização com Vulkan.
        -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!--
                Tema exibido enquanto o Flutter inicia.
            -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Necessário para o Flutter registrar os plugins automaticamente.
        -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>